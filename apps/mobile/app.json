{
  "expo": {
    "name": "Help Home",
    "slug": "help-home",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "helphome",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "br.com.helphome.app",
      "supportsTablet": false
    },
    "android": {
      "package": "br.com.helphome.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF7ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7ED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Help Home usa sua localiza\u00e7\u00e3o para marcar o local do servi\u00e7o e mostrar os pedidos mais perto de voc\u00ea."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Help Home precisa acessar suas fotos para voc\u00ea mostrar o problema e o servi\u00e7o feito.",
          "cameraPermission": "O Help Home usa a c\u00e2mera para tirar fotos do problema e do servi\u00e7o feito."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#f97316"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
