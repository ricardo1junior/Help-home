# Copie para .env.local e preencha com os dados do seu projeto no Supabase
# (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave secreta do Supabase (Project Settings > API Keys > Secret keys).
# Usada só no servidor para confirmar pagamentos e marcar CNPJs verificados.
SUPABASE_SECRET_KEY=sb_secret_...

# Endereço público do site (usado nos links de retorno e no webhook do Mercado Pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (Seu negócio > Configurações > Credenciais). Sem o token, em desenvolvimento o site usa um modo de pagamento de teste.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo das notificações (Webhooks > Configurar notificações > Assinatura secreta)
MERCADOPAGO_WEBHOOK_SECRET=

# Liga o pagamento de teste mesmo em produção (ex.: uma versão de demonstração). NUNCA use no site real.
PAGAMENTO_MODO_TESTE=false
